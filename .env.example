# Copie para .env e ajuste (o Bun carrega .env automaticamente)

# Banco MongoDB (local ou Atlas)
MONGODB_URI=mongodb://localhost:27017/fullstack-payload-examples

# Segredo do Payload (tokens, cookies) — troque por algo forte
PAYLOAD_SECRET=change-me-please

# Porta do servidor Bun
PORT=3333

# Primeiro admin criado no boot (onInit do config)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
