{
  "name": "fullstack-payload-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch index.ts",
    "build": "bun run routes:gen && bun run build.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "routes:gen": "tsr generate",
    "routes:gen:watch": "tsr generate --watch",
    "check": "bunx oxlint . --quiet",
    "test": "bun test"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "~3.88.0",
    "@payloadcms/email-resend": "~3.88.0",
    "@payloadcms/plugin-mcp": "~3.88.0",
    "@payloadcms/sdk": "~3.88.0",
    "@payloadcms/storage-vercel-blob": "~3.88.0",
    "@payloadcms/translations": "~3.88.0",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@tanstack/store": "^0.11.0",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "bun-plugin-tailwind": "^0.1.2",
    "payload": "~3.88.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.30",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6"
